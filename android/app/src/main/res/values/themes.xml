<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CustCampus" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
        熄屏提醒页专用主题。
        窗口底色用深紫而不是白色：Activity 起来到 Compose 首帧之间有一小段空窗，
        白底会在黑屏上闪一下，很难看。
    -->
    <style name="Theme.CustCampus.Alarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/alarm_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
